{
  "js": ["js/filter.js", "../lib/jquery.easyDrag.min.js"],
  "css": "css/filter.css",
  "html": "filter.html",
  "target": "page-content-wrapper",
  "options": {
    "mviewer": {
      "mbzh_services":{
        "title": "Filtrer les entités",
        "open": false,
        "zoomOnFeatures": true,
        "legendTitle": "Sélectionner une donnée :",
        "layers": [{
          "layerId": "synthese_user",
          "filter": [{
              "attribut": "level",
              "type": "button",
              "label": "Type de collectivités",
              "dataSeparator":","
            },
            {
              "attribut": "organisme",
              "type": "textbox",
              "label": "Rechercher une collectivité",
              "updateOnChange": true
            },
            {
              "attribut": "adherent",
              "type": "button",
              "label": "Utilisatrice des services",
              "updateOnChange": true,
              "dataSeparator":","
            }
          ]
        }]
      }
    }
  }
}
