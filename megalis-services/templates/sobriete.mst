
{{#features}}

<li class="item service-template service-sobriete">

    <!-- Informations sur la collectivité -->

    <h3 class="title-feature">{{organisme}}</h3>

    <div class="select-features-list">
        <span class="select-features">{{level}}</span>
        <span class="select-features">{{annee}}</span>
        <span class="select-features">SIREN : {{siren}}</span>
    </div>

    <!-- Statut du service -->

    <div class="service-container" data-service-status="{{service_sobriete}}">

        <!-- ================================== -->
        <!-- SERVICE UTILISÉ                    -->
        <!-- ================================== -->

        <div class="service-block user-service-oui">
            <div class="service-header">
                <div class="service-icon"></div>
                <div class="service-block-info">
                    <p class="service-title">
                        Parcours Sobriete Numérique
                    </p>
                    <div class="service-status">
                        <i class="ri-checkbox-circle-line"></i>
                        Service utilisé
                    </div>

                </div>

            </div>

            <div class="service-divider"></div>

            <p class="service-description">
                Cette collectivité bénéficie d'un accompagnement en Sobriete numérique en {{annee}}
            </p>

            <a class="service-button"
               href="https://services.megalis.bretagne.bzh/service/parcours-sobriete-numerique/"
               target="_blank"
               rel="noopener noreferrer">
                Accéder au service                
				<i class="ri-arrow-right-up-line"></i>
            </a>
        </div>


        <!-- ================================== -->
        <!-- SERVICE NON UTILISÉ                -->
        <!-- ================================== -->

        <div class="service-block user-service-non">

            <div class="service-header">

                <div class="service-icon"></div>

                <div class="service-block-info">

                    <p class="service-title">
                        Parcours Sobriete Numérique
                    </p>
                    <div class="service-status">   
						<i class="ri-close-circle-line"></i>                     
                        Service non utilisé
                    </div>
                </div>
            </div>

            <div class="service-divider"></div>
				<p class="service-description">
					Il semble que cette collectivité n'a pas encore bénéficié d'un accompagnement Sobriete numérique
				</p>
				<a class="service-button"
				href="https://services.megalis.bretagne.bzh/service/parcours-sobriete-numerique/"
				target="_blank"
				rel="noopener noreferrer">
					En savoir plus sur le service <i class="ri-arrow-right-up-line"></i>
				</a>
        </div>
    </div>
</li>

{{/features}}


<style>

/* ========================================== */
/* PERSONNALISATION DU SERVICE                */
/* À modifier pour chaque service            */
/* ========================================== */

.service-sobriete {
  --service-color: #07BBB1;
  --service-icon: url("../img/sobriete.svg");
}

/* Le style de ce template est centralisé dans le fichier de thème css/megalisbzh.css */
</style>
