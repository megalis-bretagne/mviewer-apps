{{#features}}
  <li class="item service-template service-pes">
    <h3 class="title-feature">{{organisme}}</h3>
    <div class="select-features-list">
      <span class="select-features">{{level}}</span>
      <span class="select-features">{{annee}}</span>
      <span class="select-features">SIREN : {{siren}}</span>
    </div>
    <div class="service-container" data-service-status="{{service_pes}}" data-siren="{{siren}}">
      <!-- Service utilise -->
      <div class="service-block user-service-oui">
        <div class="service-header">
          <div class="service-icon"></div>
          <div class="service-block-info">
            <p class="service-title">Télétransmission des flux comptables PES</p>
            <div class="service-status">
              <i class="ri-checkbox-circle-line"></i> Service utilisé
            </div>
          </div>
        </div>
        <div class="service-divider"></div>
        <p class="service-description">Cette collectivité utilise le service de télétransmission des flux comptables PES en {{annee}}</p>
        <a class="service-button" href="https://services.megalis.bretagne.bzh/service/teletransmission-des-flux-comptables-pes/" target="_blank" rel="noopener noreferrer"> En savoir plus sur le service <i class="ri-arrow-right-up-line"></i>
        </a>
      </div>
      <!-- Chiffres cles et graphiques -->
      <div class="service-summary mt-4">
        <div class="service-grid">
          <div class="service-stat-block service-stat-key" data-stat-value="{{nb_pes}}">
            <div class="service-stat-subblock">
              <div class="service-stat-icon">
                <i class="ri-file-text-line"></i>
              </div>
              <div>
                <div class="service-stat-value">{{nb_pes}}</div>
                <div class="service-stat-label">Flux PES transmis</div>
                <div class="service-stat-description">En {{annee}}</div>
              </div>
            </div>
          </div>
          <div class="service-stat-block service-chart-block service-chart-evolution">
            <div class="service-chart-container">
              <canvas class="chart chart-pes"></canvas>
              <p class="service-chart-empty" hidden>Aucune donnée disponible pour cette entité.</p>
            </div>
            <div class="service-chart-title">Évolution du nombre de flux PES transmis</div>
            <div class="service-chart-description">Pour l'entité sélectionnée</div>
          </div>
        </div>
      </div>
      <!-- Service non utilise -->
      <div class="service-block user-service-non">
        <div class="service-header">
          <div class="service-icon"></div>
          <div class="service-block-info">
            <p class="service-title">Télétransmission des flux comptables PES</p>
            <div class="service-status">
              <i class="ri-close-circle-line"></i> Service non utilisé
            </div>
          </div>
        </div>
        <div class="service-divider"></div>
        <p class="service-description">Aucune utilisation du service n'est recensée pour cette collectivité en {{annee}}</p>
        <a class="service-button" href="https://services.megalis.bretagne.bzh/service/teletransmission-des-flux-comptables-pes/" target="_blank" rel="noopener noreferrer"> En savoir plus sur le service <i class="ri-arrow-right-up-line"></i>
        </a>
      </div>
    </div>
  </li>
{{/features}}
<style>
  /* Personnalisation du service : style commun dans css/megalisbzh.css */
  .service-pes {
    --service-color: #146cb1;
    --service-icon: url("../img/teletransmission.svg");
    --service-stat-gap: 15px;
  }

  .service-pes .service-summary {
    display: none;
    min-width: 0;
    container-type: inline-size;
  }

  .service-pes [data-service-status="OUI"]>.service-summary {
    display: block;
  }

  .service-pes .service-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--service-stat-gap);
  }

  .service-pes .service-stat-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
    padding: 15px;
    background-color: white;
    border: 1px solid #e2e2e2;
    border-radius: 15px;
    box-sizing: border-box;
  }

  .service-pes .service-stat-block.service-stat-wide {
    justify-content: flex-start;
  }

  .service-pes .service-stat-subblock {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .service-pes .service-stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    padding: 10px;
    flex-shrink: 0;
    color: white;
    font-size: 28px;
    background-color: var(--service-color);
    border-radius: 5px;
  }

  .service-pes .service-stat-value {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--service-color);
  }

  .service-pes .service-stat-label {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--service-color);
  }

  .service-pes .service-stat-description {
    font-size: 12px;
    line-height: 1.4;
    color: #666;
  }

  .service-pes [data-stat-value=""] .service-stat-value::before {
    content: "—";
  }

  .service-pes .service-chart-block {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap:0px;
    padding: 20px 15px;
    text-align: center;
  }

  .service-pes .service-chart-container {
    position: relative;
    width: 100%;
    min-width: 0;
    height: 200px;
    margin-bottom: 10px;
    overflow: hidden;
  }

  .service-pes .service-chart-container canvas {
    display: block;
    max-width: 100%;
  }

  .service-pes .service-chart-title {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  .service-pes .service-chart-description {
    font-size: 11px;
    line-height: 1.4;
    color: #777;
  }

  .service-pes .service-chart-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 20px;
    font-size: 13px;
    color: #777;
  }

  .service-pes [hidden] {
    display: none !important;
  }

  /* Disposition des indicateurs */
  .service-pes .service-stat-key {
    justify-content: center;
    text-align: center;
  }

  .service-pes .service-stat-key .service-stat-subblock {
    flex-direction: column;
    gap: 15px;
  }

  .service-pes .service-stat-key .service-stat-value {
    font-size: 36px;
  }

  .service-pes .service-chart-evolution .service-chart-container {
    height: 170px;
  }



  @container (max-width: 380px) {
    .service-pes .service-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .service-pes .service-stat-key {
      justify-content: flex-start;
      text-align: left;
    }

    .service-pes .service-stat-key .service-stat-subblock {
      flex-direction: row;
    }

    .service-pes .service-stat-key .service-stat-value {
      font-size: 26px;
    }
  }
</style>
<script>
  (function() {
    const WFS_URL = "https://geobretagne.fr/geoserver/megalis/wfs";
    const CHART_URL = "https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.0.2/chart.min.js";
    const YEAR_MIN = null; // Renseigner une année pour limiter l'historique
    const YEAR_MAX = new Date().getFullYear();
    // Chargement mutualisé avec le template Marchés
    function loadChart() {
      if (typeof window.Chart === "function") return Promise.resolve(window.Chart);
      if (!window.megalisChartPromise) {
        window.megalisChartPromise = new Promise((resolve, reject) => {
          const script = document.createElement("script");
          script.src = CHART_URL;
          script.onload = () => resolve(window.Chart);
          script.onerror = () => {
            window.megalisChartPromise = null;
            script.remove();
            reject(new Error("Impossible de charger Chart.js"));
          };
          document.head.appendChild(script);
        });
      }
      return window.megalisChartPromise;
    }

    function number(value) {
      if (value == null || String(value).trim() === "") return null;
      const n = Number(value);
      return Number.isFinite(n) && n >= 0 ? n : null;
    }

    function showEmpty(canvas, message) {
      canvas.hidden = true;
      const empty = canvas.parentElement.querySelector(".service-chart-empty");
      empty.textContent = message;
      empty.hidden = false;
    }

    function chartOptions() {
      return {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        resizeDelay: 150,
        plugins: {
          legend: {
            display: false,
            position: "bottom",
            labels: {
              font: {
                family: "Open Sans",
                size: 11
              },
              boxWidth: 12
            }
          },
          tooltip: {
            titleFont: {
              family: "Open Sans"
            },
            bodyFont: {
              family: "Open Sans",
              size: 11
            }
          }
        }
      };
    }
    // Graphique 1 : évolution annuelle (WFS)
    async function drawEvolution(container) {
      const canvas = container.querySelector(".chart-pes");
      const siren = container.dataset.siren;
      try {
        if (!/^\d{9}$/.test(siren)) throw new Error("SIREN invalide");
        let filter = "siren=" + siren;
        if (YEAR_MIN !== null) filter += " AND annee >= " + YEAR_MIN;
        filter += " AND annee <= " + YEAR_MAX;
        const params = new URLSearchParams({
          service: "WFS",
          version: "2.0.0",
          request: "GetFeature",
          outputFormat: "application/json",
          typeNames: "services_organisme",
          propertyName: "annee,nb_pes",
          CQL_FILTER: filter
        });
        const response = await fetch(WFS_URL + "?" + params);
        if (!response.ok) throw new Error("Erreur WFS : " + response.status);
        const data = await response.json();
        if (!canvas.isConnected) return;
        const rows = data.features.map(f => f.properties).filter(p => p.annee != null).sort((a, b) => Number(a.annee) - Number(b.annee));
        if (!rows.length) {
          showEmpty(canvas, "Données indisponibles");
          return;
        }
        const options = chartOptions();
        options.scales = {
          x: {
            grid: {
              display: false
            },
            ticks: {
              font: {
                family: "Open Sans",
                size: 11
              }
            }
          },
          y: {
            beginAtZero: true,
            ticks: {
              precision: 0,
              font: {
                family: "Open Sans",
                size: 11
              }
            }
          }
        };
        new Chart(canvas, {
          type: "bar",
          data: {
            labels: rows.map(p => p.annee),
            datasets: [{
              label: "Flux PES transmis",
              data: rows.map(p => number(p.nb_pes)),
              backgroundColor: getComputedStyle(container).getPropertyValue("--service-color").trim() || "#146cb1",
              borderRadius: 0,
              borderSkipped: false,
              barPercentage: 0.95,
              categoryPercentage: 0.75,
              maxBarThickness: 50
            }]
          },
          options
        });
      } catch (error) {
        console.error("PES - WFS", error);
        if (canvas.isConnected) showEmpty(canvas, "Impossible de récupérer les données.");
      }
    }
    // Initialisation des fiches utilisant le service
    document.querySelectorAll('.service-pes [data-service-status="OUI"]').forEach(async container => {
      if (container.dataset.chartsInitialized === "true") return;
      container.dataset.chartsInitialized = "true";
      try {
        await loadChart();
        if (!container.isConnected) return;
        await drawEvolution(container);
      } catch (error) {
        console.error("PES - Chart.js", error);
        container.querySelectorAll("canvas.chart").forEach(canvas => {
          if (!window.Chart || !Chart.getChart(canvas)) showEmpty(canvas, "Impossible de charger le graphique.");
        });
      }
    });
  })();
</script>