{{#features}}
    <li class="item service-template service-opendata"
        id="{{feature_ol_uid}}">
        <div class="opendata-views">
            <!-- FICHE DE SYNTHÈSE           -->
            <div class="opendata-summary">
                <!-- Informations sur la collectivité -->
                <h3 class="title-feature">{{organisme}}</h3>
                <div class="select-features-list">
                    <span class="select-features">{{level}}</span>
                    <span class="select-features">{{annee}}</span>
                    <span class="select-features">SIREN : {{siren}}</span>
                </div>
                <!-- Statut du service -->
                <div class="service-container"
                    data-service-status="{{opendata_publie}}">
                    <!-- SERVICE UTILISÉ                    -->
                    <div class="service-block user-service-oui">
                        <div class="service-header">
                            <div class="service-icon"></div>
                            <div class="service-block-info">
                                <p class="service-title">
                                    Publication Open Data
                                </p>
                                <div class="service-status">
                                    <i class="ri-checkbox-circle-line"
                                    aria-hidden="true"></i>
                                    Service utilisé
                                </div>
                            </div>
                        </div>
                        <div class="service-divider"></div>
                        <p class="service-description">
                            Cette collectivité publie des documents
                            en Open Data en {{annee}}.
                        </p>
                    </div>
                    <!-- SYNTHÈSE DES PUBLICATIONS          -->
                    <div class="service-summary mt-4 user-service-oui">
                        <h4 class="service-section-title">
                            Publications en {{annee}}
                        </h4>
                        <div class="service-grid">
                            <!-- DÉLIBÉRATIONS -->
                            <div class="service-stat-block" data-stat-value="{{nb_delib_publie}}">
                                <div class="service-stat-subblock">
                                    <div class="service-stat-icon">
                                        <i class="ri-file-paper-2-line"></i>
                                    </div>
                                    <div>
                                        <div class="service-stat-value">
                                            {{nb_delib_publie}}
                                        </div>
                                        <div class="service-stat-label">
                                            Délibérations
                                        </div>
                                    </div>
                                </div>
                                {{#url_actes}}
                                    <button type="button"
                                        class="service-stat-button"
                                        onclick="showOpenDataView(this, true);">
                                        Réutiliser
                                        <i class="ri-arrow-right-up-line"></i>
                                    </button>
                                {{/url_actes}}
                            </div>
                            <!-- COMMANDES PUBLIQUES -->
                            <div class="service-stat-block" data-stat-value="{{nb_decp_publie}}">
                                <div class="service-stat-subblock">
                                    <div class="service-stat-icon">
                                        <i class="ri-megaphone-line"></i>
                                    </div>
                                    <div>
                                        <div class="service-stat-value">
                                            {{nb_decp_publie}}
                                        </div>
                                        <div class="service-stat-label">
                                            Commandes publiques
                                        </div>
                                    </div>
                                </div>
                                {{#url_marches}}
                                    <a class="service-stat-button"
                                        href="{{url_marches}}"
                                        target="_blank"
                                        rel="noopener noreferrer">
                                        Réutiliser
                                        <i class="ri-arrow-right-up-line"></i>
                                    </a>
                                {{/url_marches}}
                            </div>
                            <!-- BUDGET -->
                            <div class="service-stat-block service-stat-wide" data-budget-status="{{budget_publie}}">
                                <div class="service-stat-icon">
                                    <i class="ri-money-euro-circle-line"></i>
                                </div>
                                <div class="service-stat-info">
                                    <div class="service-stat-label">
                                        Budget de la collectivité publié
                                    </div>
                                    <div class="service-stat-description">
                                        Informations budgétaires
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- SERVICE NON UTILISÉ                -->
                    <div class="service-block user-service-non">
                        <div class="service-header">
                            <div class="service-icon"></div>
                            <div class="service-block-info">
                                <p class="service-title">
                                    Publication Open Data
                                </p>
                                <div class="service-status">
                                    <i class="ri-close-circle-line"
                                    aria-hidden="true"></i>
                                    Service non utilisé
                                </div>
                            </div>
                        </div>
                        <div class="service-divider"></div>
                        <p class="service-description">
                            Aucune publication de documents en Open Data
                            n'est recensée pour cette collectivité en {{annee}}.
                        </p>
                        <a class="service-button"
                            href="https://services.megalis.bretagne.bzh/service/opendata/"
                            target="_blank"
                            rel="noopener noreferrer">
                            En savoir plus sur le service
                            <i class="ri-arrow-right-up-line"></i>
                        </a>
                    </div>
                </div>
            </div>
            <!-- RÉUTILISATION DES DONNÉES  -->
            <div class="opendata-reuse" hidden>
                <!-- Bouton de retour -->
                <button type="button"
                    class="service-stat-button service-back-button"
                    onclick="showOpenDataView(this, false);">
                    <i class="ri-arrow-left-line"></i>
                    Retour à la fiche
                </button>
                <h3 class="title-feature">
                    Comment réutiliser les données Open Data ?
                </h3>
                <div class="mqb-container">
                    <!-- Présentation de la marque blanche -->
                    <div class="service-mqb-block">
                        <div class="service-header">
                            <div class="service-mqb-icon">
                                <i class="ri-code-s-slash-line"></i>
                            </div>
                            <div class="service-block-info">
                                <p class="service-title">
                                    Marque blanche
                                </p>
                                <p class="service-description">
                                    Intégrez les délibérations de cette
                                    collectivité directement dans votre
                                    propre site web.
                                </p>
                            </div>
                        </div>
                    </div>
                    <!-- Navigation aperçu / code -->
                    <div class="service-mqb-tabs">
                        <button type="button"
                            class="service-mqb-tab tab-preview"
                            onclick="showMarqueBlanche(this, false);">
                            <i class="ri-eye-line"></i>
                            Aperçu
                        </button>
                        <button type="button"
                            class="service-mqb-tab tab-code"
                            onclick="showMarqueBlanche(this, true);">
                            <i class="ri-code-s-slash-line"></i>
                            Code HTML
                        </button>
                    </div>
                    <!-- Contenu de la marque blanche -->
                    <div class="card service-mqb-content">
                        <!-- APERÇU -->
                        <div class="front-marqueblanche">
                            {{#url_actes}}
                                <iframe
                                    referrerpolicy="strict-origin-when-cross-origin"
                                    src="{{url_actes}}"
                                    title="Marque blanche Open Data"
                                    width="100%"
                                    height="600"
                                    loading="lazy">
                                </iframe>
                            {{/url_actes}}
                        </div>
                        <!-- CODE HTML -->
                        <div class="back-marqueblanche">
                            <p class="service-description">
                                Pour intégrer la marque blanche dans
                                votre propre site web, copiez le code
                                suivant et collez-le dans une page
                                de votre site web.
                            </p>
                            <div class="code-container">
                                <pre><code>&lt;iframe
									referrerpolicy="strict-origin-when-cross-origin"
									style="border: 0;"
									src="{{url_actes}}"
									title="Marque blanche Open Data"
									width="100%"
									height="600"&gt;
								&lt;/iframe&gt;</code></pre>
                            </div>
                            <button type="button"
                                class="service-stat-button"
                                onclick="showMarqueBlanche(this, false);">
                                <i class="ri-eye-line"></i>
                                Afficher le résultat
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </li>
{{/features}}

<style>
/* PERSONNALISATION DU SERVICE                */

.service-opendata {
    --service-color: #FD4B1E;
    --service-icon: url("../img/opendata.svg");
}

/*
 * Le style de ce template est centralisé
 * dans le fichier de thème css/megalisbzh.css.
 */

/* Navigation entre la synthèse et la réutilisation */
.service-opendata .opendata-views,
.service-opendata .opendata-summary,
.service-opendata .opendata-reuse {
    width: 100%;
}

.service-opendata .opendata-views [hidden] {
    display: none !important;
}

/* BOUTON RETOUR                              */

.service-template .service-back-button {
    margin: 0 0 15px;
}

/* PICTOGRAMMES SVG DES INDICATEURS           */

.service-template .service-stat-icon img {
    width: 40px;
    height: 40px;
    object-fit: contain;
}

/* MARQUE BLANCHE - PRÉSENTATION               */

.service-template .mqb-container {
    margin-top: 20px;
}

.service-template .service-mqb-block {
    padding: 20px;
    background-color: var(--service-color-light);
    border-radius: var(--service-radius);
}

.service-template .service-mqb-block .service-title {
    color: var(--service-color);
}

.service-template .service-mqb-block .service-description {
    color: #555b70;
    margin: 0;
}

.service-template .service-mqb-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 55px;
    height: 55px;
    background-color: var(--service-icon-color);
    border-radius: var(--service-icon-radius);
    color: white;
    font-size: 28px;
}

/* MARQUE BLANCHE - ONGLETS                    */

.service-template .service-mqb-tabs {
    display: flex;
    gap: 5px;
    padding: 5px;
    margin: 20px 0 15px;
    background-color: #f0f0f2;
    border-radius: 12px;
}

.service-template .service-mqb-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 1;
    padding: 10px;
    background-color: transparent;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    color: #666;
    cursor: pointer;
    transition:
        background-color 0.2s ease,
        color 0.2s ease;
}

.service-template .service-mqb-tab i {
    font-size: 17px;
}

/* Onglet actif : aperçu */

.service-template .mqb-container:not(.code)
.tab-preview,
/* Onglet actif : code HTML */
.service-template .mqb-container.code
.tab-code {
    background-color: white;
    color: var(--service-color);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
}

.service-template .service-mqb-tab:focus-visible {
    outline: 2px solid var(--service-color-dark);
    outline-offset: 2px;
}

/* MARQUE BLANCHE - CONTENU                    */

.service-template .service-mqb-content {
    border: 1px solid #e2e2e2;
    border-radius: 15px;
    overflow: hidden;
}

/* MARQUE BLANCHE - APERÇU                     */

.service-template .front-marqueblanche {
    display: block;
}

.service-template .front-marqueblanche iframe {
    display: block;
    width: 100%;
    height: 600px;
    border: none;
}

/* MARQUE BLANCHE - CODE HTML                  */

.service-template .back-marqueblanche {
    display: none;
    padding: 20px;
}

.service-template .back-marqueblanche
.service-description {
    color: #555b70;
}

.service-template .code-container {
    margin: 15px 0 20px;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    background-color: #f5f5f7;
    overflow: hidden;
}

.service-template .code-container pre {
    margin: 0;
    padding: 15px;
    background-color: transparent;
    border: none;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

.service-template .code-container code {
    color: var(--colorcommonservice);
    font-size: 12px;
    line-height: 1.6;
}

/* BASCULE APERÇU / CODE                       */

.service-template .mqb-container.code
.front-marqueblanche {
    display: none;
}

.service-template .mqb-container.code
.back-marqueblanche {
    display: block;
}

/* VARIABLES DES BLOCS STATISTIQUES           */

.service-template {
    --service-stat-bg: #f0f0f2;
    --service-stat-color: black;
    --service-stat-radius: 20px;
    --service-stat-gap: 15px;
}

/* SECTION DE SYNTHÈSE                        */

/* Affichage uniquement si le service est utilisé */

.service-template [data-service-status="OUI"] > .service-summary {
    display: block;
}

.service-template .service-section-title {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 15px;
}

/* GRILLE DES INDICATEURS                     */

.service-template .service-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--service-stat-gap);
}

.service-template .service-stat-block {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    padding: 15px;
    background-color: white;
    border: 1px solid #e2e2e2;
    border-radius: 15px;
    box-sizing: border-box;
    justify-content: space-between;
}

.service-template .service-stat-block.service-stat-wide{
    justify-content: start;
}
.service-stat-subblock {
    display: flex;
    align-items: center;
    gap: 20px;
}

/* PICTOGRAMMES                               */

.service-template .service-stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    padding: 10px;
    color: white;
    font-size: 28px;
    background-color: var(--service-color);
    border-radius: 5px;
}

/* CHIFFRES CLÉS                              */

.service-template .service-stat-value {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--service-color);
}

.service-template .service-stat-label {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--service-color);
}

.service-template .service-stat-description {
    font-size: 12px;
    line-height: 1.4;
    color: #666;
}

/* BOUTONS DE RÉUTILISATION                   */

.service-template .service-stat-button {
    padding: 8px 14px;
    background-color: transparent;
    border: 1px solid ;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--service-color);
    text-decoration: none;
    cursor: pointer;
    transition:
        background-color 0.2s ease,
        color 0.2s ease;
}

.service-template .service-stat-button:hover {
    color: white;
    text-decoration: none;
    background-color:  var(--service-color);
}

.service-template .service-stat-button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
}

/* Masquage si le budget n'est pas publié */

.service-template [data-budget-status="NON"] {
    display: none;
}

/* ADAPTATION À LA LARGEUR DU PANNEAU         */

.service-template .service-summary {
    container-type: inline-size;
}
</style>

<script>
/* Affichage de la vue demandée, pour la collectivité sélectionnée */
var showOpenDataView = function(element, showReuse) {
    var views = element.closest(".opendata-views");
    if (!views) return;

    views.querySelector(".opendata-summary").hidden = showReuse;
    views.querySelector(".opendata-reuse").hidden = !showReuse;

    var item = views.closest(".item");
    if (item) item.scrollTop = 0;
};

/* Bascule aperçu / code HTML */
var showMarqueBlanche = function(element, showCode) {
    var container = element.closest(".mqb-container");
    if (!container) return;

    if (typeof showCode === "boolean") {
        container.classList.toggle("code", showCode);
    } else {
        container.classList.toggle("code");
    }
};
</script>
