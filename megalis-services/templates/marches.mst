{{#features}}
  <li class="item service-template service-marches">
    <h3 class="title-feature">{{organisme}}</h3>
    <div class="select-features-list">
      <span class="select-features">{{level}}</span>
      <span class="select-features">{{annee}}</span>
      <span class="select-features">SIREN : {{siren}}</span>
    </div>
    <div class="service-container" data-service-status="{{service_sdm}}" data-siren="{{siren}}">
      <!-- Service utilise -->
      <div class="service-block user-service-oui">
        <div class="service-header">
          <div class="service-icon"></div>
          <div class="service-block-info">
            <p class="service-title">Salle des marchés publics</p>
            <div class="service-status">
              <i class="ri-checkbox-circle-line"></i> Service utilisé
            </div>
          </div>
        </div>
        <div class="service-divider"></div>
        <p class="service-description">Cette collectivité utilise le service de salle des marchés publics en {{annee}}</p>
        <a class="service-button" href="https://marches.megalis.bretagne.bzh/entreprise" target="_blank" rel="noopener noreferrer"> Accéder au service <i class="ri-arrow-right-up-line"></i>
        </a>
      </div>
      <!-- Chiffres cles et graphiques -->
      <div class="service-summary mt-4">
        <div class="service-grid">
          <div class="service-stat-block service-stat-key" data-stat-value="{{nb_procedure}}">
            <div class="service-stat-subblock">
              <div class="service-stat-icon">
                <i class="ri-file-text-line"></i>
              </div>
              <div>
                <div class="service-stat-value">{{nb_procedure}}</div>
                <div class="service-stat-label">Procédures lancées</div>
				<div class="service-stat-description">En {{annee}}</div>
              </div>
            </div>
          </div>
          <div class="service-stat-block service-chart-block">
            <div class="service-chart-container">
              <canvas class="chart chart-procedures" data-p1="{{nb_tot_pa}}" data-p2="{{nb_tot_pf_ac_sad}}"></canvas>
              <p class="service-chart-empty" hidden>Aucune donnée disponible pour cette entité.</p>
            </div>
            <div class="service-chart-title">Répartition des procédures selon la nature</div>
            <div class="service-chart-description">Pour l'entité et l'année sélectionnées</div>
          </div>
          <div class="service-stat-block service-chart-block service-chart-col1">
            <div class="service-chart-container">
              <canvas class="chart chart-marches"></canvas>
              <p class="service-chart-empty" hidden>Aucune donnée disponible pour cette entité.</p>
            </div>
            <div class="service-chart-title">Évolution des procédures lancées et réponses reçues</div>
            <div class="service-chart-description">Pour l'entité sélectionnée</div>
          </div>
        </div>
      </div>
      <!-- Service non utilise -->
      <div class="service-block user-service-non">
        <div class="service-header">
          <div class="service-icon"></div>
          <div class="service-block-info">
            <p class="service-title">Salle des marchés publics</p>
            <div class="service-status">
              <i class="ri-close-circle-line"></i> Service non utilisé
            </div>
          </div>
        </div>
        <div class="service-divider"></div>
        <p class="service-description">Aucune utilisation du service n'est recensée pour cette collectivité en {{annee}}</p>
        <a class="service-button" href="https://services.megalis.bretagne.bzh/service/salle-des-marches-publics/" target="_blank" rel="noopener noreferrer"> En savoir plus sur le service <i class="ri-arrow-right-up-line"></i>
        </a>
      </div>
    </div>
  </li>
{{/features}}
<style>
  /* Personnalisation du service : style commun dans css/megalisbzh.css */
  .service-marches {
    --service-color: #1e68b1;
    --service-icon: url("../img/marches.svg");
    --chart-color-primary: var(--service-color);
    --chart-color-secondary: color-mix(in srgb, var(--service-color) 30%, white);
    --chart-color-response: #5fc0c3;
    --service-stat-gap: 15px;
  }

  .service-marches .service-summary {
    display: none;
    min-width: 0;
  }

  .service-marches [data-service-status="OUI"]>.service-summary {
    display: block;
  }

  .service-marches .service-stat-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
    padding: 15px;
    background-color: white;
    border: 1px solid #e2e2e2;
    border-radius: 15px;
    box-sizing: border-box;
  }

  .service-marches .service-stat-block.service-stat-wide {
    justify-content: flex-start;
  }

  .service-marches .service-stat-subblock {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .service-marches .service-stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    padding: 10px;
    flex-shrink: 0;
    color: white;
    font-size: 28px;
    background-color: var(--service-color);
    border-radius: 5px;
  }

  .service-marches .service-stat-value {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--service-color);
  }

  .service-marches .service-stat-label {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--service-color);
  }

  .service-marches .service-stat-description {
    font-size: 12px;
    line-height: 1.4;
    color: #666;
  }

  .service-marches [data-stat-value=""] .service-stat-value::before {
    content: "—";
  }

  .service-marches .service-chart-block {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 0px;
    padding: 20px 15px;
    text-align: center;
  }

  .service-marches .service-chart-container {
    position: relative;
    width: 100%;
    min-width: 0;
    height: 200px;
    margin-bottom: 10px;
    overflow: hidden;
  }

  .service-marches .service-chart-container canvas {
    display: block;
    max-width: 100%;
  }

  .service-marches .service-chart-title {
    font-size: 13px;
    font-weight: 600;
  }

  .service-marches .service-chart-description {
    font-size: 11px;
    color: #777;
  }

  .service-marches .service-chart-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 20px;
    font-size: 13px;
    color: #777;
  }

  .service-marches [hidden] {
    display: none !important;
  }

  .service-marches .service-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--service-stat-gap);
    align-items: stretch;
  }

  .service-marches .service-chart-col1 {
    grid-column: 1 / -1;
  }

  /* ========================================== */
  /* CHIFFRE CLÉ                                */
  /* ========================================== */
  .service-marches .service-stat-key {
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .service-marches .service-stat-key .service-stat-subblock {
    flex-direction: column;
    gap: 15px;
  }

  .service-marches .service-stat-key .service-stat-value {
    font-size: 36px;
  }

  .service-marches .service-stat-key .service-stat-label {
    font-size: 14px;
  }

  @container (max-width: 380px) {
    .service-marches .service-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .service-marches .service-stat-key {
      justify-content: flex-start;
      text-align: left;
    }

    .service-marches .service-stat-key .service-stat-subblock {
      flex-direction: row;
      gap: 20px;
    }

    .service-marches .service-stat-key .service-stat-value {
      font-size: 26px;
    }
  }
</style>
<script>
  (function() {
    const WFS_URL = "https://geobretagne.fr/geoserver/megalis/wfs";
    const CHART_URL = "https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.0.2/chart.min.js";
    const FONT = "Open Sans";

    function loadChart() {
      if (typeof window.Chart === "function") return Promise.resolve(window.Chart);
      if (!window.megalisChartPromise) {
        window.megalisChartPromise = new Promise(function(resolve, reject) {
          const script = document.createElement("script");
          script.src = CHART_URL;
          script.onload = function() {
            resolve(window.Chart);
          };
          script.onerror = function() {
            window.megalisChartPromise = null;
            script.remove();
            reject(new Error("Impossible de charger Chart.js"));
          };
          document.head.appendChild(script);
        });
      }
      return window.megalisChartPromise;
    }

    function parseNumber(value) {
      if (value == null || String(value).trim() === "") return null;
      const number = Number(value);
      return Number.isFinite(number) && number >= 0 ? number : null;
    }

    function getColors(container) {
      const style = getComputedStyle(container);
      return {
        primary: style.getPropertyValue("--chart-color-primary").trim() || "#1e68b1",
        secondary: style.getPropertyValue("--chart-color-secondary").trim() || "#b9cfe6",
        response: style.getPropertyValue("--chart-color-response").trim() || "#5fc0c3"
      };
    }

    function showEmpty(canvas, message) {
      const chart = window.Chart && Chart.getChart(canvas);
      if (chart) chart.destroy();
      canvas.hidden = true;
      const empty = canvas.parentElement.querySelector(".service-chart-empty");
      if (empty) {
        if (message) empty.textContent = message;
        empty.hidden = false;
      }
    }

    function getChartOptions() {
      return {
        responsive: true,
        maintainAspectRatio: false,
        resizeDelay: 150,
        animation: false,
        plugins: {
          legend: {
            position: "bottom",
            labels: {
              font: {
                family: FONT,
                size: 11
              },
              boxWidth: 12,
              boxHeight: 12,
              padding: 15
            }
          },
          tooltip: {
            titleFont: {
              family: FONT
            },
            bodyFont: {
              family: FONT,
              size: 11
            }
          }
        }
      };
    }
    // Repartition des procedures
    function drawProcedures(container) {
      const canvas = container.querySelector(".chart-procedures");
      if (!canvas || Chart.getChart(canvas)) return;
      const adapted = parseNumber(canvas.dataset.p1);
      const formalized = parseNumber(canvas.dataset.p2);
      if (adapted === null || formalized === null) {
        showEmpty(canvas, "Données indisponibles");
        return;
      }
      if (adapted + formalized === 0) {
        showEmpty(canvas, "Aucune procédure recensée pour cette entité.");
        return;
      }
      const colors = getColors(container);
      new Chart(canvas, {
        type: "pie",
        data: {
          labels: ["Procédures adaptées", "Procédures formalisées"],
          datasets: [{
            label: "Procédures",
            data: [adapted, formalized],
            backgroundColor: [colors.primary, colors.secondary],
            borderWidth: 0
          }]
        },
        options: getChartOptions()
      });
    }
    // Historique WFS
    async function getWfsData(siren) {
      if (!/^\d{9}$/.test(siren)) throw new Error("SIREN invalide");
      const params = new URLSearchParams({
        service: "WFS",
        version: "2.0.0",
        request: "GetFeature",
        outputFormat: "application/json",
        typeNames: "services_organisme",
        propertyName: "annee,nb_procedure,nb_reponse",
        CQL_FILTER: "siren=" + siren
      });
      const response = await fetch(WFS_URL + "?" + params.toString());
      if (!response.ok) throw new Error("Erreur WFS : " + response.status);
      const data = await response.json();
      if (!Array.isArray(data.features)) throw new Error("Réponse WFS invalide");
      return data.features.map(function(feature) {
        return feature.properties;
      }).filter(function(p) {
        return p && p.annee != null;
      }).sort(function(a, b) {
        return Number(a.annee) - Number(b.annee);
      });
    }
    async function drawMarches(container) {
      const canvas = container.querySelector(".chart-marches");
      if (!canvas || Chart.getChart(canvas)) return;
      try {
        const data = await getWfsData(container.dataset.siren);
        if (!canvas.isConnected) return;
        if (!data.length || !data.some(function(p) {
            return parseNumber(p.nb_procedure) !== null || parseNumber(p.nb_reponse) !== null;
          })) {
          showEmpty(canvas);
          return;
        }
        const colors = getColors(container);
        const options = getChartOptions();
        options.scales = {
          x: {
            grid: {
              display: false
            },
            ticks: {
              font: {
                family: FONT,
                size: 11
              }
            }
          },
          y: {
            beginAtZero: true,
            ticks: {
              precision: 0,
              font: {
                family: FONT,
                size: 11
              }
            }
          }
        };
        new Chart(canvas, {
          type: "bar",
          data: {
            labels: data.map(function(p) {
              return p.annee;
            }),
            datasets: [{
              label: "Procédures",
              data: data.map(function(p) {
                return parseNumber(p.nb_procedure);
              }),
              backgroundColor: colors.primary,
              borderWidth: 0,
				borderRadius: 0,
				borderSkipped: false,
				barPercentage: 0.95,
				categoryPercentage: 0.75,
				maxBarThickness: 50
            }, {
              label: "Réponses",
              data: data.map(function(p) {
                return parseNumber(p.nb_reponse);
              }),
              backgroundColor: colors.response,
              borderWidth: 0,
				borderRadius: 0,
				borderSkipped: false,
				barPercentage: 0.95,
				categoryPercentage: 0.75,
				maxBarThickness: 50
            }]
          },
          options: options
        });
      } catch (error) {
        console.error("Marchés publics - erreur WFS :", error);
        if (canvas.isConnected) showEmpty(canvas, "Impossible de récupérer les données.");
      }
    }
    async function initCharts(container) {
      if (container.dataset.chartsInitialized === "true") return;
      container.dataset.chartsInitialized = "true";
      try {
        await loadChart();
        if (!container.isConnected) return;
        drawProcedures(container);
        await drawMarches(container);
      } catch (error) {
        console.error("Marchés publics - erreur Chart.js :", error);
        container.dataset.chartsInitialized = "false";
        container.querySelectorAll("canvas.chart").forEach(function(canvas) {
          showEmpty(canvas, "Impossible de charger le graphique.");
        });
      }
    }
    // Initialisation de toutes les fiches utilisant le service
    document.querySelectorAll('.service-marches [data-service-status="OUI"]').forEach(initCharts);
  })();
</script>